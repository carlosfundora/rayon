+
+    fn reference(chars: &str) -> usize {
+        let starts: Vec<_> = chars.char_indices().map(|(index, _)| index).collect();
+        starts
+            .iter()
+            .copied()
+            .find(|&index| index >= chars.len() / 2)
+            .or_else(|| starts.last().copied())
+            .unwrap_or(0)
+    }
