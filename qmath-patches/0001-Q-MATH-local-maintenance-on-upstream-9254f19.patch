+            'a',
+            '\u{7f}',
+            '\u{80}',
+            '\u{7ff}',
+            '\u{800}',
+            '\u{d7ff}',
+            '\u{e000}',
+            '\u{ffff}',
+            '\u{10000}',
+            '\u{10ffff}',
+        ] {
+            let chars = scalar.to_string();
+            assert_eq!(find_char_midpoint(&chars), 0, "{scalar:?}");
+            assert_eq!(split(&chars), None);
+        }
+    }
